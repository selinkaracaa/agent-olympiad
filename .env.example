# Copy to .env and fill in secrets (never commit .env)
TINKER_API_KEY=tml-your-key-here
PERPLEXITY_API_KEY=pplx-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional defaults
TINKER_MODEL=Qwen/Qwen3.6-35B-A3B

# VJudge local gateway (semi-automatic remote submit)
# 1) Browser login to vjudge.net, DevTools → Network → copy Cookie header
# 2) python src/vjudge_gateway.py serve --port 8787
# 3) Set the vars below before running an agent batch
VJUDGE_COOKIE=
VJUDGE_GATEWAY_URL=http://127.0.0.1:8787
# Default: submit by problem id (CodeForces-4A) using benchmark evaluation fields.
# Set to "contest" only if you intentionally use a private VJudge contest.
VJUDGE_SUBMIT_MODE=problem
VJUDGE_OJ=CodeForces
# Optional contest-mode overrides (unused when VJUDGE_SUBMIT_MODE=problem):
# VJUDGE_CONTEST_ID=845103
# VJUDGE_PROBLEM=A
# VJUDGE_ACCESS_CODE=
# 0 = VJudge default remote account; 1 = own bound OJ account (required for CF here)
VJUDGE_SUBMIT_METHOD=1
# Optional overrides if auto-detect fails:
# VJUDGE_BINDING_ID=319071
# VJUDGE_CONTEST_VERSION=6c3