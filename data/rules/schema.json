{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-olympiad.local/schemas/competition-rule-card-v1.json",
  "title": "Agent Olympiad competition rule card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rule_id",
    "competition_id",
    "profile",
    "protocol",
    "team",
    "execution",
    "allowed_tools",
    "resources",
    "submission",
    "rules_text",
    "provenance",
    "comparability"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "competition_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "official_equivalent",
        "benchmark_native",
        "proxy",
        "non_comparable"
      ]
    },
    "protocol": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "object",
      "required": [
        "active_min",
        "active_default",
        "active_max"
      ],
      "properties": {
        "active_min": {
          "type": "integer",
          "minimum": 1
        },
        "active_default": {
          "type": "integer",
          "minimum": 1
        },
        "active_max": {
          "type": "integer",
          "minimum": 1
        },
        "roster_max": {
          "type": "integer",
          "minimum": 1
        },
        "collaboration": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "max_turns"
      ],
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "scheduler": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "allowed_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "human_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agent_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "duties"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "duties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "may_submit": {
            "type": "boolean"
          },
          "information_access": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "contest_rules",
                "evaluation_guidance"
              ]
            }
          },
          "rule_expertise": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "answer_format": {
      "type": "string"
    },
    "evaluation_guidance": {
      "type": "string"
    },
    "information_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "shared",
            "role_scoped",
            "role_specialized"
          ]
        },
        "shared": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "problem",
              "contest_rules",
              "team_discussion",
              "scratchpad"
            ]
          }
        },
        "coordination_requirement": {
          "type": "string"
        }
      }
    },
    "rule_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deliberation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "unstructured",
            "structured"
          ]
        },
        "min_challenges": {
          "type": "integer",
          "minimum": 0
        },
        "decision_maker": {
          "const": "submitter"
        },
        "evaluation_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "evidence_responsiveness",
              "revision_after_challenge",
              "decision_traceability",
              "authority_bias",
              "majority_bias"
            ]
          }
        }
      }
    },
    "communication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "unlimited",
            "limited"
          ]
        },
        "team_message_budget": {
          "type": "integer",
          "minimum": 1
        },
        "per_agent_message_budget": {
          "type": "integer",
          "minimum": 1
        },
        "max_message_chars": {
          "type": "integer",
          "minimum": 1
        },
        "counted_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "speak",
              "write_scratchpad",
              "propose",
              "challenge",
              "provide_evidence",
              "revise",
              "decide"
            ]
          }
        }
      }
    },
    "scoring": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "submission": {
      "type": "object"
    },
    "rules_text": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object"
    },
    "comparability": {
      "type": "object"
    }
  }
}
