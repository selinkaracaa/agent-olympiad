{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-olympiad.local/schemas/rules-v2-catalog-draft.json",
  "title": "Agent Olympiad rules v2 draft catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_scope", "entries"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0-draft"},
    "draft_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "selectorValue": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"}
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset_id", "competition_id", "path", "selector", "status"],
      "properties": {
        "ruleset_id": {"type": "string", "minLength": 1},
        "competition_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^rulesets/.+\\.json$"},
        "selector": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selectorValue"}
        },
        "status": {"enum": ["draft", "reviewed", "production_candidate"]}
      }
    }
  }
}
