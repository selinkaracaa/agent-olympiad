{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-olympiad.local/schemas/ruleset-v2-draft.json",
  "title": "Agent Olympiad ruleset v2 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ruleset_id",
    "competition_id",
    "title",
    "profile",
    "applicability",
    "team",
    "execution",
    "resource_policy",
    "constraints",
    "collaboration",
    "submission",
    "evaluation",
    "comparability",
    "provenance"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0-draft"},
    "ruleset_id": {"type": "string", "minLength": 1},
    "competition_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "profile": {
      "enum": ["official_equivalent", "benchmark_native", "proxy", "non_comparable"]
    },
    "applicability": {"$ref": "#/$defs/applicability"},
    "team": {"$ref": "#/$defs/team"},
    "execution": {"$ref": "#/$defs/execution"},
    "resource_policy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/resourceRule"}
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "collaboration": {"$ref": "#/$defs/collaboration"},
    "submission": {"$ref": "#/$defs/submission"},
    "evaluation": {"$ref": "#/$defs/evaluation"},
    "comparability": {"$ref": "#/$defs/comparability"},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "selectorValue": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"}
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "eval_unit"],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/selectorValue"}
        },
        "eval_unit": {"enum": ["session", "question", "challenge", "artifact"]},
        "effective_years": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {"type": "integer", "minimum": 1900},
            "through": {"type": ["integer", "null"], "minimum": 1900}
          }
        },
        "notes": {"type": "string"}
      }
    },
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "title", "duties", "may_submit"],
      "properties": {
        "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "title": {"type": "string", "minLength": 1},
        "duties": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "may_submit": {"type": "boolean"}
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_min",
        "active_default",
        "active_max",
        "topology",
        "required_roles"
      ],
      "properties": {
        "active_min": {"type": "integer", "minimum": 1},
        "active_default": {"type": "integer", "minimum": 1},
        "active_max": {"type": "integer", "minimum": 1},
        "topology": {
          "enum": ["single_cooperative_team", "multi_coalition", "individual_shared_output"]
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/role"}
        },
        "fill_role": {"$ref": "#/$defs/role"}
      }
    },
    "stateRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "status", "required_for_official_equivalence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "description": {"type": "string", "minLength": 1},
        "status": {"enum": ["enforced", "specified_only", "unavailable"]},
        "required_for_official_equivalence": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_minutes", "turn_budget", "state_requirements"],
      "properties": {
        "official_minutes": {"type": ["integer", "null"], "minimum": 1},
        "turn_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "max_turns", "derivation"],
          "properties": {
            "mode": {"enum": ["wall_clock_proxy", "native_turns", "not_applicable"]},
            "max_turns": {"type": "integer", "minimum": 1},
            "derivation": {"type": "string", "minLength": 1}
          }
        },
        "state_requirements": {
          "type": "array",
          "items": {"$ref": "#/$defs/stateRequirement"}
        }
      }
    },
    "resourceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["access", "enforced_by", "source_refs"],
      "properties": {
        "access": {
          "enum": ["allowed", "forbidden", "conditional", "unavailable", "shared_capacity"]
        },
        "conditions": {"type": "string", "minLength": 1},
        "capacity": {"type": "integer", "minimum": 1},
        "enforced_by": {
          "enum": ["tool_policy", "lease", "environment", "prompt_only", "manual", "not_enforceable"]
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "status"],
      "properties": {
        "mode": {"enum": ["prompt", "runtime", "evaluator", "manual", "not_applicable"]},
        "status": {"enum": ["enforced", "specified_only", "unavailable"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "authority", "statement", "source_refs", "enforcement"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "authority": {
          "enum": ["official", "benchmark_adaptation", "benchmark_safety", "eligibility"]
        },
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "enforcement": {"$ref": "#/$defs/enforcement"},
        "waived_for_agents": {"type": "boolean"},
        "waiver_reason": {"type": "string", "minLength": 1}
      }
    },
    "coalition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coalition_id", "member_role_ids", "private_channel"],
      "properties": {
        "coalition_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "member_role_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "private_channel": {"type": "boolean"}
      }
    },
    "collaboration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topology", "opponent_model", "dynamic_role_rotation", "coalitions", "notes"],
      "properties": {
        "topology": {
          "enum": ["single_cooperative_team", "multi_coalition", "individual_shared_output"]
        },
        "opponent_model": {"enum": ["none", "external_scripted", "separate_coalitions"]},
        "dynamic_role_rotation": {"type": "boolean"},
        "coalitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/coalition"}
        },
        "notes": {"type": "string"}
      }
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_deliverable",
        "runner_deliverable",
        "official_mime_types",
        "runner_mime_types",
        "adaptation",
        "max_count"
      ],
      "properties": {
        "official_deliverable": {"type": "string", "minLength": 1},
        "runner_deliverable": {"type": "string", "minLength": 1},
        "official_mime_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "runner_mime_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "adaptation": {"type": ["string", "null"]},
        "max_count": {"type": "integer", "minimum": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evaluator_id", "rubric_path", "gold_available", "notes"],
      "properties": {
        "status": {"enum": ["ready", "ready_with_limitations", "deferred", "unassigned"]},
        "evaluator_id": {"type": ["string", "null"]},
        "rubric_path": {"type": ["string", "null"]},
        "gold_available": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "dimension": {
      "enum": ["equivalent", "adapted", "proxy", "unavailable", "not_applicable"]
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "official_rule", "benchmark_treatment", "impact"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "official_rule": {"type": "string", "minLength": 1},
        "benchmark_treatment": {"type": "string", "minLength": 1},
        "impact": {"enum": ["minor", "material", "fundamental"]}
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "dimensions", "waivers", "unsupported_mechanisms"],
      "properties": {
        "overall": {
          "enum": ["equivalent", "comparable_with_adaptations", "proxy", "non_comparable", "draft"]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "roster",
            "timing",
            "resources",
            "collaboration",
            "submission",
            "scoring",
            "participant_identity"
          ],
          "properties": {
            "roster": {"$ref": "#/$defs/dimension"},
            "timing": {"$ref": "#/$defs/dimension"},
            "resources": {"$ref": "#/$defs/dimension"},
            "collaboration": {"$ref": "#/$defs/dimension"},
            "submission": {"$ref": "#/$defs/dimension"},
            "scoring": {"$ref": "#/$defs/dimension"},
            "participant_identity": {"$ref": "#/$defs/dimension"}
          }
        },
        "waivers": {
          "type": "array",
          "items": {"$ref": "#/$defs/waiver"}
        },
        "unsupported_mechanisms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "url",
        "authority",
        "retrieved_at",
        "snapshot_status"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "authority": {"enum": ["official", "organizer", "benchmark", "research_report"]},
        "retrieved_at": {"type": "string", "format": "date"},
        "effective_year": {"type": ["integer", "null"], "minimum": 1900},
        "local_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "locator": {"type": "string", "minLength": 1},
        "snapshot_status": {"enum": ["archived", "linked_only"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "generated_at", "research_confidence", "notes"],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source"}
        },
        "generated_at": {"type": "string", "format": "date-time"},
        "research_confidence": {"enum": ["high", "medium", "low"]},
        "notes": {"type": "string"}
      }
    }
  }
}
